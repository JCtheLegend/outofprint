# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@yourdomain.com

# Lulu Print API — https://developers.lulu.com/user-profile/api-keys
# Use https://api.sandbox.lulu.com (and sandbox credentials from
# developers.sandbox.lulu.com) until you are ready to print for real.
LULU_CLIENT_KEY=your-lulu-client-key
LULU_CLIENT_SECRET=your-lulu-client-secret
LULU_API_URL=https://api.sandbox.lulu.com
# Who Lulu contacts about a problem with a print job
LULU_CONTACT_EMAIL=orders@yourdomain.com
# Fallback phone for the shipping address; carriers require one
LULU_DEFAULT_PHONE=+1-555-0100

# Optional print settings (defaults shown)
# LULU_SHIPPING_LEVEL=MAIL              # MAIL | PRIORITY_MAIL | GROUND | EXPEDITED | EXPRESS
# LULU_PRODUCTION_DELAY_MINUTES=120     # cancellation window, 60-2880
# LULU_POD_PACKAGE_ID=0600X0900.BW.STD.PB.060UC444.MXX   # used when a book has none

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
